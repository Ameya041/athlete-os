# Copy this file to .env.local for local development.
# In production (Vercel), add these same names under Project Settings > Environment Variables instead.

# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Also from Supabase: Project Settings > API (this one is SECRET - never share, never put in NEXT_PUBLIC_ vars)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# From console.groq.com > API Keys (SECRET, free tier, no credit card needed)
GROQ_API_KEY=gsk_xxxxx

# For daily "log your session" reminders (push notifications) — generate your own with:
#   npx web-push generate-vapid-keys
# (run inside the project folder after `npm install`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-public-key
VAPID_PRIVATE_KEY=your-private-key
# Any random long string of your choosing — protects the reminder endpoint from being triggered by strangers
CRON_SECRET=make-up-a-long-random-string-here
