# Copy this file to .env.local for local development.
# In production (Vercel), add these same names under Project Settings > Environment Variables instead.

# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Also from Supabase: Project Settings > API (this one is SECRET - never share, never put in NEXT_PUBLIC_ vars)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# From console.groq.com > API Keys (SECRET, free tier, no credit card needed)
GROQ_API_KEY=gsk_xxxxx
